generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("executive")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integrations Integration[]
  messages     Message[]
  tasks        Task[]        @relation("TaskAssignee")
  createdTasks Task[]        @relation("TaskCreator")
  notes        KnowledgeNote[]
  aiJobs       AIJob[]

  @@map("users")
}

model Integration {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // gmail, whatsapp, sms
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  metadata     Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userId, provider])
  @@map("integrations")
}

model Message {
  id            String   @id @default(cuid())
  integrationId String
  userId        String
  externalId    String
  provider      String   // gmail, whatsapp, sms
  fromAddress   String
  fromName      String?
  subject       String?
  body          String
  summary       String?
  htmlBody      String?
  receivedAt    DateTime
  isRead        Boolean  @default(false)
  isArchived    Boolean  @default(false)
  priority      String   @default("normal") // urgent, high, normal, low
  sentiment     String?  // positive, neutral, negative
  actionItems   Json?    // array of detected action items
  suggestedActions Json? // array of suggested next actions
  labels        String[] @default([])
  threadId      String?
  aiProcessed   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  tasks       Task[]

  @@unique([integrationId, externalId])
  @@index([userId, receivedAt])
  @@index([userId, priority])
  @@map("messages")
}

model Task {
  id           String    @id @default(cuid())
  userId       String
  creatorId    String
  messageId    String?
  title        String
  description  String?
  status       String    @default("pending") // pending, in_progress, completed, cancelled
  priority     String    @default("medium")  // urgent, high, medium, low
  dueDate      DateTime?
  completedAt  DateTime?
  assigneeName String?
  tags         String[]  @default([])
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignee User     @relation("TaskAssignee", fields: [userId], references: [id])
  creator  User     @relation("TaskCreator", fields: [creatorId], references: [id])
  message  Message? @relation(fields: [messageId], references: [id])

  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("tasks")
}

model KnowledgeNote {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("note") // note, meeting, decision, vendor, project, contact
  title     String
  content   String
  tags      String[] @default([])
  metadata  Json?
  embedding Float[]  @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@map("knowledge_notes")
}

model AIJob {
  id          String    @id @default(cuid())
  userId      String
  type        String    // email_processing, brief_generation, task_creation
  status      String    @default("pending") // pending, running, completed, failed
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("ai_jobs")
}

model ExecutiveBrief {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  content   Json     // structured brief content
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("executive_briefs")
}
