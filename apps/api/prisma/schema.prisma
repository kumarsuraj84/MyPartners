generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Commercial Foundation ────────────────────────────────────────────────────
// tenantId = userId in V1 (single-user tenants).
// Tenant model is the anchor for future multi-user workspaces.

model Tenant {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("free")    // free, starter, professional, enterprise
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  configs   TenantConfig[]

  @@map("tenants")
}

// Versioned key-value configuration per tenant.
// Replaces all hardcoded business rules, limits, and assistant behaviour.
model TenantConfig {
  id        String   @id @default(cuid())
  tenantId  String
  category  String   // assistant | priority_rules | business_hours | notifications | reminder_policies | feature_flags | brief
  key       String
  value     Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, category, key])
  @@index([tenantId, category])
  @@map("tenant_configs")
}

// Append-only audit trail for all significant business events.
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  action    String   // created | updated | deleted | connected | disconnected | config_changed | role_changed | plan_changed | ai_provider_changed
  entity    String   // user | integration | task | message | config | ai_provider | feature_flag
  entityId  String?
  before    Json?
  after     Json?
  metadata  Json?    // request IP, user agent, session context
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  role       String   @default("executive") // owner | executive | manager | assistant | administrator
  plan       String   @default("free")      // free | starter | professional | enterprise
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  integrations     Integration[]
  messages         Message[]
  tasks            Task[]        @relation("TaskAssignee")
  createdTasks     Task[]        @relation("TaskCreator")
  notes            KnowledgeNote[]
  aiJobs           AIJob[]
  suggestedActions SuggestedAction[]
  decisions        Decision[]

  @@map("users")
}

// ─── Business Memory Domain Objects ───────────────────────────────────────────
// tenantId = userId in V1 (each user is their own tenant).
// When multi-tenant support is added, tenantId references a Tenant model.

model Person {
  id             String   @id @default(cuid())
  tenantId       String   // userId in V1
  name           String
  email          String?
  role           String?
  company        String?  // denormalized from Organization for quick display
  description    String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String
  updatedBy      String?

  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  messageEntities MessageEntity[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("persons")
}

model Organization {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  domain      String?  // email domain for automatic matching (e.g. "acmecorp.com")
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String?

  persons         Person[]
  projects        Project[]
  messageEntities MessageEntity[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("organizations")
}

model Project {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  status         String   @default("active") // active, completed, on_hold
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String
  updatedBy      String?

  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  businessDecisions BusinessDecision[]
  messageEntities MessageEntity[]

  @@index([tenantId])
  @@map("projects")
}

model BusinessDecision {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  status      String   @default("made") // made, pending, reversed
  madeAt      DateTime @default(now())
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String
  updatedBy   String?

  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id])
  messageEntities MessageEntity[]

  @@index([tenantId])
  @@map("decisions")
}

// EOS Executive Decision — tracks decisions presented to the executive for approval/deferral
model Decision {
  id              String   @id @default(cuid())
  userId          String
  sourceSignalId  String?
  title           String
  category        String   @default("Strategic")
  escalation      String   @default("important")  // critical | urgent | important
  priority        String   @default("waiting")     // urgent | today | waiting
  recommendation  String
  whyItMatters    String
  businessImpact  String
  businessImpactSummary String
  actionIfDelayed String?
  suggestedDeadline String?
  confidenceLevel String   @default("medium")     // high | medium | low
  confidenceNote  String?
  preparedBy      String   @default("Chief of Staff")
  estimatedTime   String   @default("5 min")
  context         Json     @default("[]")
  relatedDecisions Json    @default("[]")
  status          String   @default("pending")    // pending | approved | changes_requested | deferred
  statusNote      String?
  decidedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("eos_decisions")
}

// Junction table: links a message to every domain object extracted from it.
// Exactly one of personId/organizationId/projectId/decisionId is non-null per row.
model MessageEntity {
  id             String   @id @default(cuid())
  tenantId       String   // mirrors the owning tenant for cross-tenant query safety
  messageId      String
  entityType     String   // person | organization | project | decision
  confidence     Float    @default(1.0)
  extractedText  String?  // the text snippet that triggered this extraction
  createdAt      DateTime @default(now())

  personId         String?
  organizationId   String?
  projectId        String?
  businessDecisionId String?

  message          Message            @relation(fields: [messageId], references: [id])
  person           Person?            @relation(fields: [personId], references: [id])
  organization     Organization?      @relation(fields: [organizationId], references: [id])
  project          Project?           @relation(fields: [projectId], references: [id])
  businessDecision BusinessDecision?  @relation(fields: [businessDecisionId], references: [id])

  @@index([tenantId])
  @@index([messageId])
  @@index([personId])
  @@index([organizationId])
  @@index([projectId])
  @@index([businessDecisionId])
  @@map("message_entities")
}

model Integration {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // gmail, whatsapp, sms
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  metadata     Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userId, provider])
  @@map("integrations")
}

model Message {
  id            String   @id @default(cuid())
  integrationId String
  userId        String
  externalId    String
  provider      String   // gmail, whatsapp, sms
  fromAddress   String
  fromName      String?
  subject       String?
  body          String
  summary       String?
  htmlBody      String?
  receivedAt    DateTime
  isRead        Boolean  @default(false)
  isArchived    Boolean  @default(false)
  priority         String   @default("normal") // urgent, high, normal, low
  priorityReason   String?  // why the AI assigned this priority
  messageCategory  String?  // request, update, fyi, decision, commitment, introduction
  sentiment        String?  // positive, neutral, negative
  actionItems      Json?    // array of detected action items
  labels           String[] @default([])
  threadId         String?
  aiProcessed      Boolean  @default(false)
  metadata         Json?    // entities, key dates, and other extracted structured data
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  integration      Integration       @relation(fields: [integrationId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  tasks            Task[]
  suggestedActions SuggestedAction[]
  messageEntities  MessageEntity[]

  @@unique([integrationId, externalId])
  @@index([userId, receivedAt])
  @@index([userId, priority])
  @@index([userId, aiProcessed])
  @@index([userId, isRead, isArchived])
  @@map("messages")
}

model Task {
  id           String    @id @default(cuid())
  userId       String
  creatorId    String
  messageId    String?
  title        String
  description  String?
  status       String    @default("pending") // pending, in_progress, completed, cancelled
  priority     String    @default("medium")  // urgent, high, medium, low
  category     String    @default("task")    // task, commitment, follow_up, waiting_for
  dueDate      DateTime?
  waitingFrom  String?   // person we are waiting on (for waiting_for category)
  completedAt  DateTime?
  assigneeName String?
  tags         String[]  @default([])
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignee User     @relation("TaskAssignee", fields: [userId], references: [id])
  creator  User     @relation("TaskCreator", fields: [creatorId], references: [id])
  message  Message? @relation(fields: [messageId], references: [id])

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, dueDate])
  @@index([userId, category, status])
  @@map("tasks")
}

model SuggestedAction {
  id         String   @id @default(cuid())
  userId     String
  messageId  String
  label      String
  type       String   // reply, delegate, schedule, follow_up, archive, create_task
  detail     String?
  isDismissed Boolean @default(false)
  isActedOn  Boolean @default(false)
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  message Message @relation(fields: [messageId], references: [id])

  @@index([userId, isDismissed])
  @@map("suggested_actions")
}

model KnowledgeNote {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("note") // note, meeting, decision, vendor, project, contact
  title     String
  content   String
  tags      String[] @default([])
  metadata  Json?
  embedding Float[]  @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@map("knowledge_notes")
}

model AIJob {
  id          String    @id @default(cuid())
  userId      String
  type        String    // email_processing, brief_generation, task_creation
  status      String    @default("pending") // pending, running, completed, failed
  input       Json?
  output      Json?
  metadata    Json?     // pipeline stage tracking and extra context
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("ai_jobs")
}

model ExecutiveBrief {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  content   Json     // structured brief content
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("executive_briefs")
}

// A Signal is a proactively-generated observation — not a task, not an alert.
// Generated deterministically from Business Memory; no new AI prompts required.
model Signal {
  id              String    @id @default(cuid())
  userId          String
  type            String    // overdue_commitment | unacknowledged_urgent | waiting_overdue | follow_up_overdue
  title           String
  reason          String    // why this signal was generated ("why am I seeing this?")
  businessImpact  String    // consequence if ignored ("what happens if I ignore it?")
  suggestedAction String    // one concrete recommendation
  urgency         String    @default("normal") // critical | high | normal
  entityType      String?   // task | message | project
  entityId        String?   // the specific record that triggered this signal
  isDismissed     Boolean   @default(false)
  snoozedUntil    DateTime?
  isResolved      Boolean   @default(false)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, isDismissed, isResolved])
  @@index([userId, type])
  @@index([userId, entityType, entityId])
  @@map("signals")
}
